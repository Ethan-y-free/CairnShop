# CairnShop backend environment (copy to .env, never commit real secrets)

CAIRNSHOP_MYSQL_HOST=127.0.0.1
CAIRNSHOP_MYSQL_PORT=3306
CAIRNSHOP_MYSQL_USER=cairnshop
CAIRNSHOP_MYSQL_PASSWORD=cairnshop
CAIRNSHOP_MYSQL_DATABASE=cairnshop
CAIRNSHOP_MYSQL_POOL_SIZE=4

CAIRNSHOP_HTTP_HOST=0.0.0.0
CAIRNSHOP_HTTP_PORT=8080
CAIRNSHOP_SESSION_TTL_SECONDS=604800
CAIRNSHOP_COOKIE_SECURE=0

CAIRNSHOP_ADMIN_EMAIL=admin@cairnshop.local
CAIRNSHOP_ADMIN_PASSWORD=admin123456
CAIRNSHOP_MIGRATIONS_DIR=db/migrations
