# Copy to .env.production on the server. Never commit real secrets.

# Public hostname / TLS (VPS profile)
DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com

# Cloudflare Tunnel (home/VM profile). Leave empty for a quick tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Image tags (built locally or pulled from a registry)
CAIRNSHOP_VERSION=v0.2.0
CAIRNKV_TAG=v1.0.1

# MySQL
MYSQL_DATABASE=cairnshop
MYSQL_USER=cairnshop
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Internal service DNS (Docker Compose network)
CAIRNSHOP_MYSQL_HOST=mysql
CAIRNSHOP_MYSQL_PORT=3306
CAIRNSHOP_MYSQL_DATABASE=cairnshop
CAIRNSHOP_MYSQL_USER=cairnshop
CAIRNSHOP_MYSQL_PASSWORD=change-me
CAIRNSHOP_HTTP_HOST=0.0.0.0
CAIRNSHOP_HTTP_PORT=8080
CAIRNSHOP_CAIRNKV_ADDRS=cairnkv-1:6666,cairnkv-2:6666,cairnkv-3:6666
CAIRNSHOP_MIGRATIONS_DIR=db/migrations

# Bootstrap admin (change before first deploy)
CAIRNSHOP_ADMIN_EMAIL=admin@example.com
CAIRNSHOP_ADMIN_PASSWORD=change-me

# Runtime
CAIRNSHOP_SESSION_TTL_SECONDS=604800
CAIRNSHOP_COOKIE_SECURE=1
CAIRNSHOP_CONFIG_REFRESH_MS=500
CAIRNSHOP_CONFIG_MAX_STALE_MS=30000
